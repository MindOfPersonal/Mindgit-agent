# =============================================================================
#  MindGit Agent v2 — configuratie
# =============================================================================
#  Kopieer dit bestand naar ".env" en vul de waarden in. Het .env-bestand is
#  geheim (bevat je node-key) en staat in .gitignore.
#
#  Waarden uit de MindGit-dashboard: Nodes > Node toevoegen.
# =============================================================================

# --- Verplicht ---------------------------------------------------------------

# Adres van je MindGit-server (de coordinator), zoals DEZE machine die bereikt.
COORDINATOR_URL=http://localhost:3000

# Node-key uit het dashboard (wordt maar één keer getoond).
NODE_KEY=your-node-key-from-dashboard

# --- Logging -----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# true = mooie, leesbare logs in de terminal; false = JSON (handig voor services).
# Laat leeg voor automatisch (aan als de terminal een TTY is).
# LOG_PRETTY=true

# Pad naar een logbestand. Leeg = alleen naar de console (aanbevolen met systemd/nssm).
# LOG_FILE=/var/log/mindgit-agent.log

# --- Git ---------------------------------------------------------------------

# Timeouts in milliseconden.
GIT_TIMEOUT=15000
GIT_LONG_TIMEOUT=30000

# Aantal pogingen voor tijdelijke git-fouten (netwerk/lock). 0 = niet opnieuw.
GIT_MAX_RETRIES=2

# Auteur voor automatische commits.
GIT_USER_NAME=MindFramework Auto-Sync
GIT_USER_EMAIL=mindframework@auto.sync

# --- Netwerk / verbinding ----------------------------------------------------

# Heartbeat-interval in ms (moet lager zijn dan de offline-detectie van de server).
HEARTBEAT_INTERVAL=30000

# Maximale duur van één taak in ms voordat de agent hem afbreekt.
TASK_TIMEOUT=300000

# Herverbinden: basisvertraging en maximum aantal pogingen (0 = oneindig).
RECONNECT_BASE_DELAY=5000
RECONNECT_MAX_ATTEMPTS=0

# --- Bestandssysteem browse --------------------------------------------------

# Komma-gescheiden lijst met mappen die de dashboard-browser mag tonen.
# Leeg = de home-map van de gebruiker (of / als fallback).
# BROWSE_ROOTS=/home/user/projecten,/srv/repos

# --- Auto-update -------------------------------------------------------------

# De agent werkt zichzelf bij vanuit deze (publieke) GitHub-repo.
UPDATE_ENABLED=true
UPDATE_REPO=MindOfPersonal/Mindgit-agent
UPDATE_BRANCH=master
# UPDATE_PATH=                 # submap in de repo, indien van toepassing
UPDATE_INTERVAL=3600000        # check-interval in ms (default 1 uur)

# Controleer de update-manifest (sha256 per bestand). Uit = alleen versiecheck.
UPDATE_VERIFY=true
